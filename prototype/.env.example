# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=15

OAUTH_PROVIDER=google
OAUTH_CLIENT_ID=your-google-client-id
OAUTH_CLIENT_SECRET=your-google-client-secret

# Dev only: set to bypass OAuth on core + admin APIs (GET /auth/dev-login?email=...).
# Compose passes this to chat-ui and admin-ui as VITE_DEV_DEFAULT_EMAIL for one-click demo.
# DEV_MOCK_USER=dev@example.com

# Docker-built chat-ui + admin-ui: show demo / dev login in the SPAs (Vite bakes at image build).
# After changing, run: docker compose build chat_ui admin_ui && docker compose up -d
# VITE_DEV_MOCK_USER=true

# ── CORS (core API) ───────────────────────────────────────────────────────────
# Origins allowed to call the API from a browser (comma-separated). Match your UI URL.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Service URLs (used by automation-tests) ───────────────────────────────────
CORE_URL=http://localhost:8000
ADMIN_URL=http://localhost:8002
CHUNKING_URL=http://localhost:8001

# ── DB DSNs (overridden per service in docker-compose.yml) ───────────────────
# source_db  → port 5433
# vector_db  → port 5434
# system_db  → port 5435
