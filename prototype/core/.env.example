# System Database (PostgreSQL with asyncpg driver)
SYSTEM_DSN=postgresql+asyncpg://user:password@system_db:5432/systemdb

# Vector Database (PostgreSQL with asyncpg driver)
VECTOR_DSN=postgresql+asyncpg://user:password@vector_db:5432/vectordb

# OpenAI
OPENAI_API_KEY=sk-...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# JWT
JWT_SECRET=your-secret-key-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=15

# OAuth (Google)
OAUTH_PROVIDER=google
OAUTH_CLIENT_ID=...
OAUTH_CLIENT_SECRET=...

# Dev Mock User (optional - for local development)
DEV_MOCK_USER=dev@example.com
